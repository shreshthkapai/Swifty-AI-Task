# Chat runtime
CHAT_ENVIRONMENT=local
CHAT_PROVIDER=openai
CHAT_MODEL=gpt-4.1-mini
# Optional faster model for structural turn planning; defaults to CHAT_MODEL.
# CHAT_PLANNER_MODEL=gpt-4.1-mini
CHAT_ALLOWED_ORIGIN=http://localhost:4173
CHAT_DATABASE_PATH=./data/webchat.sqlite3
CHAT_RETENTION_DAYS=7
CHAT_PROVIDER_TIMEOUT_SECONDS=20
CHAT_DATABASE_TIMEOUT_SECONDS=5
CHAT_MAX_BODY_BYTES=16384
CHAT_MAX_MESSAGE_CHARS=4000

# Planning provider (server-side only)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# Northstar dealer adapter (server-side only)
NORTHSTAR_BASE_URL=http://localhost:4010
NORTHSTAR_PUBLIC_BASE_URL=http://localhost:4010
NORTHSTAR_API_KEY=northstar-local-development
NORTHSTAR_CONNECT_TIMEOUT_SECONDS=2
NORTHSTAR_READ_TIMEOUT_SECONDS=5
NORTHSTAR_WRITE_TIMEOUT_SECONDS=5
NORTHSTAR_POOL_TIMEOUT_SECONDS=2
